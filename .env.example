# ─────────────────────────────────────────────────────────────────────────────
# Book Intelligence — environment
# Copy to .env.local (git-ignored) and fill in the blanks:
#   cp .env.example .env.local
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database — PostgreSQL with pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/book_intelligence
DATABASE_POOL_MAX=10

# AI provider
#   ollama — local models via Ollama (https://ollama.com): private, no API cost
#   openai — OpenAI API (needs OPENAI_API_KEY), or any OpenAI-compatible API such as Google Gemini (below)
AI_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────────────────────
# Pull the models first:  ollama pull llama3.1:8b && ollama pull nomic-embed-text
# Check the setup with:   npm run ai:check
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any chat model works; 7–14B instruction models are a good balance (llama3.1:8b, qwen3:8b, gemma3:12b).
OLLAMA_CHAT_MODEL=llama3.1:8b
# Optional smaller/faster model for query rewriting and book insights (defaults to the chat model).
OLLAMA_UTILITY_MODEL=
# Embedding model (≤ 1536 dims; smaller vectors are zero-padded, which doesn't change similarity).
# Alternatives: qwen3-embedding:0.6b, embeddinggemma, mxbai-embed-large. Prefixes are applied automatically.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Context window per request. Prompts are budgeted to fit (keep ≤ the model's own context length).
OLLAMA_NUM_CTX=8192
# Max answer length (tokens)
OLLAMA_NUM_PREDICT=1200
# Low temperature keeps answers close to the text
OLLAMA_TEMPERATURE=0.2
# How long Ollama keeps models loaded between requests
OLLAMA_KEEP_ALIVE=15m
# For thinking models (qwen3, deepseek-r1, gpt-oss): false = faster, direct answers
OLLAMA_THINK=
# Optional overrides for embedding prefixes ("none" disables the defaults)
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# ── OpenAI (hosted) ─────────────────────────────────────────────────────────
# To use Google Gemini's free tier instead (see DEPLOY.md), set AI_PROVIDER=openai and:
#   OPENAI_API_KEY=<your Gemini API key from Google AI Studio>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_CHAT_MODEL=gemini-3.5-flash
#   OPENAI_UTILITY_MODEL=gemini-3.1-flash-lite
#   OPENAI_REASONING_EFFORT=minimal   (thinking counts against answer length; "low" can return empty answers)
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure OpenAI proxy, vLLM, LM Studio…)
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Smaller/faster model for internal tasks (query rewriting, insights). Defaults to OPENAI_CHAT_MODEL.
OPENAI_UTILITY_MODEL=gpt-5.4-nano
# Optional, for reasoning models: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Optional, only for models that accept it
OPENAI_TEMPERATURE=
CHAT_MAX_OUTPUT_TOKENS=4000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate a short description and tailored suggested questions per book (one model call per book)
GENERATE_BOOK_INSIGHTS=true

# Embeddings — EMBEDDING_DIMENSIONS is the size of the vector column (1536)
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
# Token budget per embedding request (default 120000). Gemini free tier: 20000 (its limit is 30000 tokens/minute)
EMBEDDING_MAX_TOKENS_PER_REQUEST=

# Storage — local | s3 (S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Uploads
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=2500

# Background processing
# true: the worker runs inside the Next.js server. Set false and run `npm run worker` to scale separately.
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000

# Chunking (tokens)
CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=900
CHUNK_MIN_TOKENS=180
CHUNK_OVERLAP_TOKENS=120

# Retrieval
RETRIEVAL_CANDIDATES=15
RETRIEVAL_TOP_K=7
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
# Minimum cosine similarity for a passage to count as relevant. Leave empty for a calibrated
# per-model default (text-embedding-3: 0.20, nomic-embed-text: 0.50). Scales differ by model.
RETRIEVAL_MIN_SIMILARITY=
# pgvector >= 0.8 iterative index scans (keeps filtered HNSW queries complete)
RETRIEVAL_ITERATIVE_SCAN=true
# Token budget for retrieved passages sent to the model. Empty = 7000 for OpenAI, 3000 for Ollama.
# Local models read prompts at a few hundred tokens/s, so a bigger budget means a longer wait.
CONTEXT_MAX_TOKENS=
# heuristic | llm
RERANKER=heuristic

# Rate limits — shared by everyone using the app (there are no accounts)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_HOUR=20
# Optional daily caps, e.g. to stay inside a free AI quota on a public deployment (empty = no daily cap)
RATE_LIMIT_CHAT_PER_DAY=
RATE_LIMIT_UPLOADS_PER_DAY=

# Public deployment: false turns off renaming/deleting books and chats and re-processing finished books
# (uploading and asking still work). Read at build time, so set it before building.
NEXT_PUBLIC_ALLOW_BOOK_CHANGES=true
